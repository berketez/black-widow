      "test": "tests/test_macho_f1.py",
      "find": "re.compile(r\"^_?OUTLINED_FUNCTION_\\d+$\")",
      "replace": "re.compile(r\"^OUTLINED_FUNCTION_\\d+$\")"
    },
    {
