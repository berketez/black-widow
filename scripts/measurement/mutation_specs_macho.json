      "test": "tests/test_macho_f1.py",
      "find": "    (CLASS_COLD, re.compile(r\"\\.cold(?:\\.\\d+)?$\")),",
      "replace": "    (CLASS_COLD, re.compile(r\"\\.cold_never$\")),"
