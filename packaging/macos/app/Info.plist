<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Black Widow</string>
  <key>CFBundleDisplayName</key><string>Black Widow</string>
  <key>CFBundleIdentifier</key><string>com.berketezgocen.karadul</string>
  <key>CFBundleExecutable</key><string>BlackWidow</string>
  <key>CFBundleIconFile</key><string>Karadul</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <!-- Arayüz Türkçe: bundle'ın varsayılan dili de Türkçe olmalı. -->
  <key>CFBundleDevelopmentRegion</key><string>tr</string>
  <!-- DİKKAT: aşağıdaki üç sürüm/telif alanını build_mac_app.sh PlistBuddy ile
       pyproject.toml'dan EZER (tek kaynak = pyproject). Buradaki değerler yalnızca
       betik çalıştırılmadan plist tek başına okunursa geçerli olan yedeklerdir. -->
  <key>CFBundleVersion</key><string>1.20.0</string>
  <key>CFBundleShortVersionString</key><string>1.20.0</string>
  <!-- Eski (legacy) Get Info dizesi: modern Finder bunun yerine
       CFBundleShortVersionString + NSHumanReadableCopyright gösterir. Yine de
       geçerli bir anahtar ve bazı araçlar (ör. dosya denetçileri) hâlâ okur. -->
  <key>CFBundleGetInfoString</key><string>1.20.0, © 2026 Berke Tezgöçen</string>
  <!-- Finder "Bilgi Al" panelinde ve standart Hakkında panelinde görünür.
       Bu anahtar YOKTU: Hakkında panelinin telifsiz görünmesinin sebebi buydu. -->
  <key>NSHumanReadableCopyright</key><string>© 2026 Berke Tezgöçen · MIT Lisansı</string>
  <!-- Launchpad/mağaza sınıflandırması; geliştirici aracı. -->
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- WKWebView'in http://127.0.0.1 (yerel UI server) yüklemesine izin ver -->
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
  <!-- KLASÖR-İZNİ AÇIKLAMALARI (TCC purpose string'leri).
       TUZAK: bu anahtarlar OLMADAN macOS, Desktop/Documents/Downloads ve
       harici/ağ diski erişimini SESSİZCE reddeder veya app'i çökertir. VARLIKLARI
       ilk erişimde izin penceresini tetikler; string kullanıcıya orada gösterilir.
       DİKKAT: build_mac_app.sh yalnızca 3 sürüm alanını PlistBuddy "Set" ile EZER
       (Set var olan anahtarı değiştirir, yenileri SİLMEZ) -> bu 5 anahtar korunur. -->
  <key>NSDesktopFolderUsageDescription</key>
  <string>Black Widow, analiz için Masaüstü'nden seçtiğiniz çalıştırılabilir dosyaları okur.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Black Widow, analiz için Belgeler klasöründen seçtiğiniz çalıştırılabilir dosyaları okur.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Black Widow, analiz için İndirilenler klasöründen seçtiğiniz çalıştırılabilir dosyaları okur.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Black Widow, analiz için harici disklerden seçtiğiniz çalıştırılabilir dosyaları okur.</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>Black Widow, analiz için ağ disklerinden seçtiğiniz çalıştırılabilir dosyaları okur.</string>
</dict>
</plist>
